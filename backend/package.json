{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "node --import tsx/esm --watch src/index.ts",
    "start": "node --import tsx/esm src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test tests/**/*.test.ts",
    "gen:openapi": "node --import tsx/esm scripts/dump-openapi.ts",
    "gen:asyncapi": "node --import tsx/esm scripts/dump-asyncapi.ts",
    "gen:client": "openapi-ts",
    "gen": "pnpm gen:openapi && pnpm gen:asyncapi && pnpm gen:client",
    "audit": "pnpm audit --prod"
  },
  "dependencies": {
    "@daloyjs/core": "^1.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}